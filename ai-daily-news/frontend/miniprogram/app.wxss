/**app.wxss**/
page {
  background-color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 20rpx;
}

/* 通用卡片样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-hover {
  transition: transform 0.2s ease;
}

.card-hover:active {
  transform: scale(0.98);
}

/* 文章列表项 */
.news-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.news-item:last-child {
  border-bottom: none;
}

.news-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.news-excerpt {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.news-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.news-source {
  background: #e0f2fe;
  color: #0284c7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.news-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 标签样式 */
.tag {
  display: inline-block;
  background: #dbeafe;
  color: #1d4ed8;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-ai {
  background: #fce7f3;
  color: #db2777;
}

.tag-tech {
  background: #dcfce7;
  color: #16a34a;
}

.tag-business {
  background: #fef3c7;
  color: #d97706;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #94a3b8;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e2e8f0;
  border-top: 4rpx solid #1e40af;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 搜索框样式 */
.search-container {
  padding: 20rpx;
  background: white;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  border: 1rpx solid #e2e8f0;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 20rpx 0;
}